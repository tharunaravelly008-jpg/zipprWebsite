# API Backend URL (Local: http://localhost:8000, Render: https://zippr-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# WebSocket Backend URL (Optional - automatically inferred from VITE_API_URL if omitted)
# Local: ws://localhost:8000, Render: wss://zippr-backend.onrender.com
VITE_WS_URL=ws://localhost:8000

# Mapbox GL Access Token (Optional, falls back to Leaflet if not set)
VITE_MAPBOX_TOKEN=
