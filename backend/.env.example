# Backend environment example
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL (Render automatically sets this. Supports postgres:// or postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://zippr:9121665288@localhost:5432/zipprdb

# CORS Allowed Origins (Comma-separated, JSON list, or "*" in production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Redis URL (Optional, defaults to localhost)
REDIS_URL=redis://localhost:6379/0
